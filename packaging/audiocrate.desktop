[Desktop Entry]
Type=Application
Name=AudioCrate
GenericName=Music Player
Comment=Audio player with live DSP, parametric EQ, visualizers and chiptune support
Exec=audiocrate %F
Icon=audiocrate
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/aac;audio/x-wav;audio/x-ms-wma;audio/x-ape;audio/x-aiff;
StartupNotify=true
StartupWMClass=AudioCrate
